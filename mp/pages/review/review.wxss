/* 今日 — no numbers on this screen on purpose. The dots say where you are; the counts live on
   书架. Reading should not be measured while you are doing it. */

.dots {
  display: flex;
  justify-content: center;
  gap: 14rpx;
  height: 12rpx;
  align-items: center;
  margin-bottom: 48rpx;
}
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 99rpx;
  background: #e2dacd;
}
.dot.done { background: #918879; }
.dot.here { background: #a8352c; transform: scale(1.4); }

.reveal { margin-top: 44rpx; }
.reveal-btn {
  display: flex;
  align-items: center;
  font-size: 26rpx;
}
.chev { margin-right: 12rpx; font-size: 22rpx; }
.reveal .note { margin-top: 24rpx; }

.answers {
  display: flex;
  gap: 24rpx;
  margin-top: 56rpx;
}
.ans {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  border: 1rpx solid #e2dacd;
  border-radius: 4rpx;
  font-family: "Songti SC", serif;
  font-size: 30rpx;
  letter-spacing: 0.06em;
  color: #5d564c;
}
.ans.again:active { border-color: #9a5540; color: #9a5540; }
.ans.got:active { border-color: #3f6b4d; color: #3f6b4d; }

.counter {
  text-align: center;
  margin-top: 28rpx;
  font-size: 23rpx;
  color: #918879;
}

/* the answer's consequence, said out loud */
.echo {
  text-align: center;
  padding: 120rpx 0;
  font-family: "Songti SC", serif;
  font-size: 32rpx;
  letter-spacing: 0.08em;
}

/* finished for today */
.done { text-align: center; padding: 140rpx 0 60rpx; }
.seal {
  width: 190rpx;
  height: 190rpx;
  margin: 0 auto 52rpx;
  border: 5rpx solid #a8352c;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  color: #a8352c;
  font-family: "Songti SC", serif;
  font-size: 50rpx;
  line-height: 1.15;
  letter-spacing: 0.08em;
  transform: rotate(-4deg);
  opacity: 0.92;
}
.done-h { font-family: "Songti SC", serif; font-size: 38rpx; margin-bottom: 16rpx; }
.done-p { color: #918879; font-size: 27rpx; }

/* nothing imported */
.blank { text-align: center; padding: 130rpx 0; }
.blank-h { font-family: "Songti SC", serif; font-size: 36rpx; margin-bottom: 18rpx; }
.blank-p { color: #918879; font-size: 27rpx; margin-bottom: 44rpx; }
.blank-btn {
  display: inline-block;
  padding: 22rpx 48rpx;
  border: 1rpx solid #e2dacd;
  border-radius: 4rpx;
  font-family: "Songti SC", serif;
  font-size: 29rpx;
  letter-spacing: 0.06em;
}
.blank-btn:active { border-color: #a8352c; color: #a8352c; }
