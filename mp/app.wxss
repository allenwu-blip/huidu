/**
 * Shared tokens: the same 纸与墨 palette and page components as the web build.
 *
 * WXSS has no custom properties that reach every page reliably and no colour functions, so
 * the values are written out. Keep them in step with app/index.html by hand: two clients,
 * one look. Palette: paper #ebe5d8, sheet #f8f5ee, pile #f0ebe0, ink #231f19 / #5a5245 /
 * #8a8071, rule #d8d0bf / #e4ddce, seal #b23a2e.
 */
page {
  background: #ebe5d8;
  color: #231f19;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 32rpx;
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
}

.wrap {
  padding: 40rpx 36rpx 60rpx;
}

.serif {
  font-family: "Songti SC", "STSong", "Source Han Serif SC", "Noto Serif CJK SC", serif;
}

/* ── the page: the object on screen is a book page, not a card ───────────────────────── */
.page {
  position: relative;
  background: #f8f5ee;
  background-image: linear-gradient(90deg, rgba(60, 44, 18, 0.055), rgba(60, 44, 18, 0) 88rpx);
  border-radius: 8rpx;
  padding: 52rpx 48rpx 32rpx 60rpx;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.7),
    0 0 0 1rpx rgba(60, 44, 18, 0.05),
    0 2rpx 4rpx rgba(60, 44, 18, 0.06),
    0 28rpx 68rpx -32rpx rgba(60, 44, 18, 0.3),
    0 72rpx 140rpx -72rpx rgba(60, 44, 18, 0.22);
  transform-origin: left center;
}
/* the binding: cloth colour comes inline, the gradient gives it a rounded look */
.spine {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 10rpx;
  border-radius: 8rpx 0 0 8rpx;
  background-color: #8a8071;
  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.24), rgba(255, 255, 255, 0) 30%, rgba(0, 0, 0, 0.18));
}

/* running head */
.head {
  padding-right: 100rpx;
  padding-bottom: 28rpx;
  margin-bottom: 44rpx;
  border-bottom: 1rpx solid #e4ddce;
}
.head .l1 { line-height: 1.4; }
.bk {
  font-family: "Songti SC", "STSong", serif;
  font-size: 31rpx;
  font-weight: 600;
  color: #231f19;
  letter-spacing: 0.04em;
}
.au { font-size: 25rpx; color: #8a8071; margin-left: 18rpx; letter-spacing: 0.06em; }
.head .l2 {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #8a8071;
  letter-spacing: 0.03em;
}
.ch { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.when { flex: none; white-space: nowrap; margin-left: 20rpx; }
.ago { font-weight: 500; }
.sep { opacity: 0.45; margin: 0 10rpx; }

/* 藏书章: one glyph, the first of the title, where a stamp would sit */
.chop {
  position: absolute;
  right: 44rpx;
  top: 44rpx;
  width: 72rpx;
  height: 72rpx;
  border: 3rpx solid #b23a2e;
  border-radius: 6rpx;
  color: #b23a2e;
  font-family: "Songti SC", "STSong", serif;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-7deg);
  opacity: 0.74;
}

/* the printed text. System serif only: a CJK face alone is over the 2 MB package cap. */
.quote {
  font-family: "Songti SC", "STSong", "Source Han Serif SC", "Noto Serif CJK SC", serif;
  font-size: 41rpx;
  line-height: 1.95;
  color: #231f19;
  letter-spacing: 0.02em;
  text-align: justify;
  white-space: pre-line;
  word-break: break-word;
}
.quote.hang { text-indent: -0.62em; }

/* 旁批: the reader's own words, in a hand, beside the print */
.note {
  border-left: 3rpx solid #d8d0bf;
  padding: 4rpx 0 4rpx 34rpx;
  font-family: "Kaiti SC", "STKaiti", "KaiTi", "楷体", "Songti SC", serif;
  font-size: 35rpx;
  line-height: 1.9;
  color: #5a5245;
  white-space: pre-line;
  word-break: break-word;
}

.muted { color: #8a8071; font-size: 24rpx; }
.seal-red { color: #b23a2e; }
